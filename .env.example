# Copy this file to .env and edit as needed.

# SQLite is the default (zero-config, good for dev/hackathon demo).
# For production/Postgres, uncomment and set this instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://tobaccoshield:password@localhost:5432/tobaccoshield
DATABASE_URL=sqlite:///./tobaccoshield.db

# JWT secret - change this in any real deployment
SECRET_KEY=change-this-super-secret-key-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Where uploaded images / heatmaps are stored on disk
UPLOAD_DIR=./uploads

# Toggle whether to try importing the REAL tobaccoshield_quality package (Member B)
# and a real risk model package (Member C) before falling back to the bundled stubs.
USE_REAL_QUALITY_MODULE=true
USE_REAL_RISK_MODULE=true
